class TicketModal(discord.ui.Modal, title="فتح تذكرة جديدة"):
    subject = discord.ui.TextInput(
        label="موضوع الطلب",
        placeholder="مثال: طلب إداري / شكوى / اقتراح",
        max_length=100
    )
    details = discord.ui.TextInput(
        label="تفاصيل الطلب",
        placeholder="اكتب تفاصيل طلبك بشكل واضح ومختصر...",
        style=discord.TextStyle.paragraph,
        max_length=1000
    )

    async def on_submit(self, interaction: discord.Interaction):
        guild = interaction.guild
        cfg = get_config(guild.id)

        category = guild.get_channel(cfg["category_id"]) if cfg["category_id"] else None

        if not category:
            return await interaction.response.send_message(
                "❌ نظام التذاكر غير مسطب بعد. الإدارة تحتاج تضغط **إعداد النظام > تسطيب النظام**.",
                ephemeral=True
            )

        # Prevent duplicate open ticket
        existing = db.execute(
            "SELECT channel_id FROM tickets WHERE guild_id=? AND owner_id=? AND closed=0",
            (guild.id, interaction.user.id)
        ).fetchone()

        if existing and guild.get_channel(existing["channel_id"]):
            return await interaction.response.send_message(
                f"❌ عندك تذكرة مفتوحة بالفعل: <#{existing['channel_id']}>",
                ephemeral=True
            )

        overwrites = {
            guild.default_role: discord.PermissionOverwrite(view_channel=False),
            interaction.user: discord.PermissionOverwrite(
                view_channel=True, send_messages=True, read_message_history=True
            )
        }

        # Admins can see tickets
        for role in guild.roles:
            if role.permissions.administrator or role.permissions.manage_guild:
                overwrites[role] = discord.PermissionOverwrite(
                    view_channel=True, send_messages=True, read_message_history=True,
                    manage_messages=True
                )

        channel = await guild.create_text_channel(
            name=f"ticket-{clean_name(interaction.user.name)}",
            category=category,
            overwrites=overwrites,
            reason=f"Ticket opened by {interaction.user}"
        )

        db.execute(
            "INSERT INTO tickets(channel_id,guild_id,owner_id,subject,created_at) VALUES(?,?,?,?,?)",
            (channel.id, guild.id, interaction.user.id, str(self.subject), datetime.utcnow().isoformat())
        )
        db.commit()

        await channel.send(
            content=interaction.user.mention,
            embed=embed(
                f"🎫 {self.subject}",
                f"**صاحب التذكرة:** {interaction.user.mention}\n"
                f"**الموضوع:** {self.subject}\n\n"
                f"**التفاصيل:**\n{self.details}\n\n"
                "سيتم مراجعة الطلب من الإدارة. يرجى عدم تكرار الرسائل وانتظار الرد."
            ),
            view=TicketControlView()
        )

        await interaction.response.send_message(
            f"✅ تم فتح تذكرتك: {channel.mention}",
            ephemeral=True
        )

        await send_log(
            guild,
            f"تم فتح تذكرة جديدة\n"
            f"العضو: {interaction.user.mention}\n"
            f"القناة: {channel.mention}\n"
            f"الموضوع: {self.subject}"
        )


class TicketControlView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @discord.ui.button(label="استلام التذكرة", style=discord.ButtonStyle.primary, custom_id="cd:ticket_claim")
    async def claim(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not is_admin(interaction.user):
            return await interaction.response.send_message("❌ للإدارة فقط.", ephemeral=True)

        row = db.execute(
            "SELECT * FROM tickets WHERE channel_id=? AND closed=0",
            (interaction.channel.id,)
        ).fetchone()

        if not row:
            return await interaction.response.send_message("❌ هذه ليست تذكرة مسجلة.", ephemeral=True)

        db.execute(
            "UPDATE tickets SET claimed_by=? WHERE channel_id=?",
            (interaction.user.id, interaction.channel.id)
        )
        db.commit()

        await interaction.response.send_message(
            embed=embed(
                "تم استلام التذكرة",
                f"تم استلام التذكرة بواسطة {interaction.user.mention}.\n"
                "سيتم متابعة الطلب من المسؤول المستلم."
            )
        )
        await send_log(
            interaction.guild,
            f"تم استلام التذكرة {interaction.channel.mention} بواسطة {interaction.user.mention}",
            discord.Color.blue()
        )

    @discord.ui.button(label="إغلاق التذكرة 🔒", style=discord.ButtonStyle.danger, custom_id="cd:ticket_close")
    async def close(self, interaction: discord.Interaction, button: discord.ui.Button):
        row = db.execute(
            "SELECT * FROM tickets WHERE channel_id=? AND closed=0",
            (interaction.channel.id,)
        ).fetchone()

        if not row:
            return await interaction.response.send_message("❌ التذكرة غير موجودة.", ephemeral=True)

        if interaction.user.id != row["owner_id"] and not is_admin(interaction.user):
            return await interaction.response.send_message("❌ صاحب التذكرة أو الإدارة فقط.", ephemeral=True)

        db.execute(
            "UPDATE tickets SET closed=1 WHERE channel_id=?",
            (interaction.channel.id,)
        )
        db.commit()

        await interaction.response.send_message(
            embed=embed("🔒 تم إغلاق التذكرة", "سيتم حذف القناة بعد ثوانٍ.", discord.Color.dark_grey())
        )

        await send_log(
            interaction.guild,
            f"تم إغلاق التذكرة `{interaction.channel.name}` بواسطة {interaction.user.mention}",
            discord.Color.dark_grey()
        )

        await asyncio.sleep(5)
        try:
            await interaction.channel.delete(reason="Ticket closed")
        except discord.HTTPException:
            pass

    @discord.ui.button(label="إضافة عضو", style=discord.ButtonStyle.secondary, custom_id="cd:ticket_add")
    async def add_member(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not is_admin(interaction.user):
            return await interaction.response.send_message("❌ للإدارة فقط.", ephemeral=True)
        await interaction.response.send_modal(AddMemberModal())


