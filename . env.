# -----------------------------
# Database
# -----------------------------
def db_init():
    db.executescript("""
    CREATE TABLE IF NOT EXISTS config (
        guild_id INTEGER PRIMARY KEY,
        category_id INTEGER DEFAULT 0,
        ticket_log_id INTEGER DEFAULT 0,
        admin_log_id INTEGER DEFAULT 0,
        panel_channel_id INTEGER DEFAULT 0,
        panel_message_id INTEGER DEFAULT 0
    );

    CREATE TABLE IF NOT EXISTS points (
        guild_id INTEGER NOT NULL,
        user_id INTEGER NOT NULL,
        points INTEGER NOT NULL DEFAULT 0,
        PRIMARY KEY (guild_id, user_id)
    );

    CREATE TABLE IF NOT EXISTS tickets (
        channel_id INTEGER PRIMARY KEY,
        guild_id INTEGER NOT NULL,
        owner_id INTEGER NOT NULL,
        subject TEXT NOT NULL,
        created_at TEXT NOT NULL,
        claimed_by INTEGER DEFAULT 0,
        closed INTEGER DEFAULT 0
    );

    CREATE TABLE IF NOT EXISTS activations (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        guild_id INTEGER NOT NULL,
        member_id INTEGER NOT NULL,
        psn TEXT NOT NULL,
        activated_by INTEGER NOT NULL,
        created_at TEXT NOT NULL
    );
    """)
    db.commit()


def get_config(guild_id: int):
    row = db.execute("SELECT * FROM config WHERE guild_id = ?", (guild_id,)).fetchone()
    if not row:
        db.execute("INSERT INTO config(guild_id) VALUES(?)", (guild_id,))
        db.commit()
        row = db.execute("SELECT * FROM config WHERE guild_id = ?", (guild_id,)).fetchone()
    return row


def set_config(guild_id: int, **values):
    allowed = {
        "category_id", "ticket_log_id", "admin_log_id",
        "panel_channel_id", "panel_message_id"
    }
    values = {k: v for k, v in values.items() if k in allowed}
    if not values:
        return
    parts = ", ".join(f"{k} = ?" for k in values)
    db.execute(
        f"UPDATE config SET {parts} WHERE guild_id = ?",
        (*values.values(), guild_id)
    )
    db.commit()


def add_points(guild_id: int, user_id: int, amount: int):
    row = db.execute(
        "SELECT points FROM points WHERE guild_id=? AND user_id=?",
        (guild_id, user_id)
    ).fetchone()
    if row:
        new_value = row["points"] + amount
        db.execute(
            "UPDATE points SET points=? WHERE guild_id=? AND user_id=?",
            (new_value, guild_id, user_id)
        )
    else:
        new_value = amount
        db.execute(
            "INSERT INTO points(guild_id,user_id,points) VALUES(?,?,?)",
            (guild_id, user_id, amount)
        )
    db.commit()
    return new_value


def get_points(guild_id: int, user_id: int):
    row = db.execute(
        "SELECT points FROM points WHERE guild_id=? AND user_id=?",
        (guild_id, user_id)
    ).fetchone()
    return row["points"] if row else 0


def clean_name(text: str):
    text = re.sub(r"[^a-zA-Z0-9\u0600-\u06FF_-]+", "-", text)
    return text[:40].strip("-") or "ticket"


