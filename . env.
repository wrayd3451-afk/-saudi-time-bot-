async def make_transcript(channel: discord.TextChannel):
    messages = []
    try:
        async for msg in channel.history(limit=500, oldest_first=True):
            timestamp = msg.created_at.strftime("%Y-%m-%d %H:%M:%S")
            messages.append(
                f"[{timestamp}] {msg.author} ({msg.author.id}): "
                f"{msg.content}\n"
            )
    except discord.HTTPException:
        return

    content = "".join(messages) or "لا توجد رسائل."
    data = io.BytesIO(content.encode("utf-8"))
    data.seek(0)

    if LOG_CHANNEL_ID and channel.guild:
        log_channel = channel.guild.get_channel(LOG_CHANNEL_ID)
        if isinstance(log_channel, discord.TextChannel):
            try:
                await log_channel.send(
                    content=f"📜 Transcript: `{channel.name}`",
                    file=discord.File(data, filename=f"{channel.name}.txt")
                )
            except discord.HTTPException:
                pass


