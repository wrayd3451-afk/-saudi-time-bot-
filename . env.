db = sqlite3.connect(DB_PATH, check_same_thread=False)
db.row_factory = sqlite3.Row


def db_init():
    db.executescript("""
    CREATE TABLE IF NOT EXISTS players (
        discord_id INTEGER PRIMARY KEY,
        vrp_id TEXT UNIQUE,
        name TEXT NOT NULL,
        activated INTEGER NOT NULL DEFAULT 0,
        job TEXT NOT NULL DEFAULT 'مدني',
        rank TEXT NOT NULL DEFAULT 'مواطن',
        points INTEGER NOT NULL DEFAULT 0,
        money INTEGER NOT NULL DEFAULT 0,
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS point_logs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        discord_id INTEGER NOT NULL,
        amount INTEGER NOT NULL,
        reason TEXT NOT NULL,
        moderator_id INTEGER NOT NULL,
        created_at TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS punishments (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        discord_id INTEGER NOT NULL,
        reason TEXT NOT NULL,
        moderator_id INTEGER NOT NULL,
        created_at TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS employment_logs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        discord_id INTEGER NOT NULL,
        action TEXT NOT NULL,
        job TEXT,
        rank TEXT,
        moderator_id INTEGER NOT NULL,
        created_at TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS action_logs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        actor_id INTEGER NOT NULL,
        action TEXT NOT NULL,
        target_id INTEGER,
        details TEXT,
        created_at TEXT NOT NULL
    );
    """)
    db.commit()


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def get_player(discord_id: int):
    return db.execute(
        "SELECT * FROM players WHERE discord_id = ?",
        (discord_id,)
    ).fetchone()


def upsert_player(discord_id: int, name: str, **fields):
    current = get_player(discord_id)
    stamp = now()

    if not current:
        allowed = {
            "vrp_id": None,
            "activated": 0,
            "job": "مدني",
            "rank": "مواطن",
            "points": 0,
            "money": 0,
        }
        allowed.update(fields)
        db.execute("""
            INSERT INTO players
            (discord_id, vrp_id, name, activated, job, rank, points, money,
             created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            discord_id, allowed["vrp_id"], name, allowed["activated"],
            allowed["job"], allowed["rank"], allowed["points"],
            allowed["money"], stamp, stamp
        ))
    else:
        fields["name"] = name
        fields["updated_at"] = stamp
        if fields:
            keys = list(fields.keys())
            sql = "UPDATE players SET " + ", ".join(
                f"{k} = ?" for k in keys
            ) + " WHERE discord_id = ?"
            db.execute(sql, [fields[k] for k in keys] + [discord_id])

    db.commit()
    return get_player(discord_id)


def log_action(actor_id: int, action: str,
               target_id: Optional[int] = None,
               details: str = ""):
    db.execute("""
        INSERT INTO action_logs
        (actor_id, action, target_id, details, created_at)
        VALUES (?, ?, ?, ?, ?)
    """, (actor_id, action, target_id, details, now()))
    db.commit()


