            print(f"[SYNC] Synced {len(synced)} global commands")
    except Exception as e:
        print("[SYNC ERROR]", repr(e))

    print("==========================================")
    print(f"Logged in as: {bot.user} ({bot.user.id})")
    print("Crown Dream VRP system is ONLINE")
    print("==========================================")


