def is_admin(member: discord.Member):
    return member.guild_permissions.administrator or member.guild_permissions.manage_guild


def embed(title, description="", color=discord.Color.dark_red()):
    return discord.Embed(
        title=title,
        description=description,
        color=color,
        timestamp=datetime.utcnow()
    )


async def send_log(guild: discord.Guild, message: str, color=discord.Color.red()):
    cfg = get_config(guild.id)
    channel_id = cfg["admin_log_id"]
    if not channel_id:
        return
    channel = guild.get_channel(channel_id)
    if channel:
        await channel.send(embed=embed("سجل النظام", message, color))


