@app_commands.describe(member="العضو", psn="PSN ID")
async def activation_command(interaction: discord.Interaction, member: discord.Member, psn: str):
    if not is_admin(interaction.user):
        return await interaction.response.send_message("❌ هذا الأمر للإدارة فقط.", ephemeral=True)

