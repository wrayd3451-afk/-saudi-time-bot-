                     العدد: int, السبب: str = "بدون سبب"):
    if not is_admin(interaction):
        return await deny(interaction)
    if العدد <= 0:
        return await interaction.response.send_message(
            "❌ العدد يجب أن يكون أكبر من صفر.", ephemeral=True
