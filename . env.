class PointsModal(discord.ui.Modal):
    def __init__(self, add=True):
        self.add_mode = add
        super().__init__(title="إعطاء نقاط" if add else "خصم نقاط")

    member_id = discord.ui.TextInput(
        label="ID العضو",
        placeholder="Discord User ID",
        max_length=25
    )
    amount = discord.ui.TextInput(
        label="عدد النقاط",
        placeholder="مثال: 15",
        max_length=6
    )
    reason = discord.ui.TextInput(
        label="السبب",
        placeholder="سبب العملية",
        required=False,
        max_length=150
    )

    async def on_submit(self, interaction: discord.Interaction):
        try:
            uid = int(str(self.member_id))
            amount = int(str(self.amount))
        except ValueError:
            return await interaction.response.send_message("❌ تأكد من الـ ID وعدد النقاط.", ephemeral=True)

        if amount <= 0 or amount > 10000:
            return await interaction.response.send_message("❌ عدد النقاط يجب أن يكون بين 1 و10000.", ephemeral=True)

        member = interaction.guild.get_member(uid)
        if not member:
            try:
                member = await interaction.guild.fetch_member(uid)
            except (discord.NotFound, discord.HTTPException):
                return await interaction.response.send_message("❌ العضو غير موجود.", ephemeral=True)

        final_amount = amount if self.add_mode else -amount
        total = add_points(interaction.guild.id, uid, final_amount)

        action = "إضافة" if self.add_mode else "خصم"
        await interaction.response.send_message(
            embed=embed(
                f"تم {action} النقاط ✅",
                f"العضو: {member.mention}\n"
                f"العملية: **{final_amount:+d} نقطة**\n"
                f"السبب: {self.reason or 'بدون سبب'}\n"
                f"الرصيد الجديد: **{total} نقطة**",
                discord.Color.green() if self.add_mode else discord.Color.red()
            )
        )


class MemberInfoModal(discord.ui.Modal, title="بحث عن عضو"):
    member_id = discord.ui.TextInput(
        label="ID العضو",
        placeholder="Discord User ID",
        max_length=25
    )

    async def on_submit(self, interaction: discord.Interaction):
        try:
            uid = int(str(self.member_id))
            member = interaction.guild.get_member(uid) or await interaction.guild.fetch_member(uid)
        except (ValueError, discord.NotFound, discord.HTTPException):
            return await interaction.response.send_message("❌ العضو غير موجود.", ephemeral=True)

        points = get_points(interaction.guild.id, member.id)
        activation = db.execute(
            "SELECT * FROM activations WHERE guild_id=? AND member_id=? ORDER BY id DESC LIMIT 1",
            (interaction.guild.id, member.id)
        ).fetchone()

        text = (
            f"**العضو:** {member.mention}\n"
            f"**ID:** `{member.id}`\n"
            f"**النقاط:** **{points}**\n"
        )

        if activation:
            text += (
                f"**PSN:** `{activation['psn']}`\n"
                f"**آخر تفعيل:** <t:{int(datetime.fromisoformat(activation['created_at']).timestamp())}:R>"
            )
        else:
            text += "**التفعيل:** لا يوجد سجل"

        await interaction.response.send_message(embed=embed("بيانات العضو", text), ephemeral=True)


