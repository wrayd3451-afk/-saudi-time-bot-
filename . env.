    @discord.ui.button(label="تسطيب النظام", style=discord.ButtonStyle.danger)
    async def setup_system(self, interaction: discord.Interaction, button: discord.ui.Button):
        await interaction.response.defer(ephemeral=True)

        guild = interaction.guild

        category = discord.utils.get(guild.categories, name="CROWN DREAM | TICKETS")
        if not category:
            category = await guild.create_category("CROWN DREAM | TICKETS")

        admin_log = discord.utils.get(guild.text_channels, name="cd-admin-logs")
        if not admin_log:
            admin_log = await guild.create_text_channel("cd-admin-logs")

        ticket_log = discord.utils.get(guild.text_channels, name="cd-ticket-logs")
        if not ticket_log:
            ticket_log = await guild.create_text_channel("cd-ticket-logs")

        # Hide logs from @everyone
        for ch in (admin_log, ticket_log):
            try:
                await ch.set_permissions(
                    guild.default_role,
                    view_channel=False
                )
            except discord.HTTPException:
                pass

        set_config(
            guild.id,
            category_id=category.id,
            admin_log_id=admin_log.id,
            ticket_log_id=ticket_log.id
        )

        await interaction.followup.send(
            embed=embed(
                "تم تسطيب النظام ✅",
                f"📁 التصنيف: {category.mention}\n"
                f"📋 سجل الإدارة: {admin_log.mention}\n"
                f"🎫 سجل التذاكر: {ticket_log.mention}\n\n"
                "النظام جاهز. الآن اضغط **نشر اللوحة** من الإعدادات."
            ),
            ephemeral=True
        )

    @discord.ui.button(label="نشر اللوحة", style=discord.ButtonStyle.primary)
    async def publish_panel(self, interaction: discord.Interaction, button: discord.ui.Button):
        if not is_admin(interaction.user):
            return await interaction.response.send_message("❌ للإدارة فقط.", ephemeral=True)

        msg = await interaction.channel.send(
            embed=main_panel_embed(),
            view=MainPanelView()
        )
        set_config(
            interaction.guild.id,
            panel_channel_id=interaction.channel.id,
            panel_message_id=msg.id
        )

        await interaction.response.send_message("✅ تم نشر لوحة التحكم هنا.", ephemeral=True)


