    db.execute("""
        INSERT INTO point_logs
        (discord_id, amount, reason, moderator_id, created_at)
        VALUES (?, ?, ?, ?, ?)
    """, (العضو.id, العدد, السبب, interaction.user.id, now()))
    db.commit()
    log_action(interaction.user.id, "إضافة نقاط", العضو.id,
               f"+{العدد}; {السبب}")

    await interaction.response.send_message(
        f"⭐ تمت إضافة **{العدد}** نقطة إلى {العضو.mention}.\n"
